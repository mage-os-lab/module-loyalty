<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="mageos_loyalty_points" resource="default" engine="innodb"
           comment="Loyalty points ledger (balance = sum of points)">
        <column xsi:type="int" name="entry_id" unsigned="true" nullable="false" identity="true" comment="ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="int" name="points" unsigned="false" nullable="false"
                comment="Points earned (+) or spent (-)"/>
        <column xsi:type="varchar" name="comment" length="255" nullable="true" comment="Comment"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entry_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MAGEOS_LOYALTY_POINTS_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="mageos_loyalty_points" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
    <table name="quote" resource="checkout">
        <column xsi:type="int" name="loyalty_points" unsigned="true" nullable="true" comment="Loyalty points spent"/>
        <column xsi:type="decimal" name="base_loyalty_amount" precision="20" scale="4" nullable="true"
                comment="Base amount paid with loyalty points"/>
        <column xsi:type="decimal" name="loyalty_amount" precision="20" scale="4" nullable="true"
                comment="Amount paid with loyalty points"/>
    </table>
    <table name="sales_order" resource="sales">
        <column xsi:type="int" name="loyalty_points" unsigned="true" nullable="true" comment="Loyalty points spent"/>
        <column xsi:type="decimal" name="base_loyalty_amount" precision="20" scale="4" nullable="true"
                comment="Base amount paid with loyalty points"/>
        <column xsi:type="decimal" name="loyalty_amount" precision="20" scale="4" nullable="true"
                comment="Amount paid with loyalty points"/>
    </table>
    <table name="sales_invoice" resource="sales">
        <column xsi:type="decimal" name="base_loyalty_amount" precision="20" scale="4" nullable="true"
                comment="Base amount paid with loyalty points"/>
        <column xsi:type="decimal" name="loyalty_amount" precision="20" scale="4" nullable="true"
                comment="Amount paid with loyalty points"/>
    </table>
    <table name="sales_creditmemo" resource="sales">
        <column xsi:type="decimal" name="base_loyalty_amount" precision="20" scale="4" nullable="true"
                comment="Base amount paid with loyalty points"/>
        <column xsi:type="decimal" name="loyalty_amount" precision="20" scale="4" nullable="true"
                comment="Amount paid with loyalty points"/>
    </table>
</schema>
