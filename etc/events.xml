<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- an invoice is paid, and a credit memo refunded, before it is saved: marked first, written once saved -->
    <event name="sales_order_invoice_pay">
        <observer name="mageos_loyalty_document" instance="MageOS\Loyalty\Observer\Document"/>
    </event>
    <event name="sales_order_invoice_save_after">
        <observer name="mageos_loyalty_document" instance="MageOS\Loyalty\Observer\Document"/>
    </event>
    <event name="sales_order_creditmemo_refund">
        <observer name="mageos_loyalty_document" instance="MageOS\Loyalty\Observer\Document"/>
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="mageos_loyalty_document" instance="MageOS\Loyalty\Observer\Document"/>
    </event>
    <!-- points are noted before the order is placed, and spent when it is -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="mageos_loyalty_redeem" instance="MageOS\Loyalty\Observer\Redeem"/>
    </event>
    <event name="sales_order_place_before">
        <observer name="mageos_loyalty_redeem" instance="MageOS\Loyalty\Observer\Redeem"/>
    </event>
    <event name="sales_model_service_quote_submit_failure">
        <observer name="mageos_loyalty_restore" instance="MageOS\Loyalty\Observer\Restore"/>
    </event>
    <event name="order_cancel_after">
        <observer name="mageos_loyalty_restore" instance="MageOS\Loyalty\Observer\Restore"/>
    </event>
    <!-- a payment denied after review cancels the order without "order_cancel_after" -->
    <event name="sales_order_save_before">
        <observer name="mageos_loyalty_restore" instance="MageOS\Loyalty\Observer\Restore"/>
    </event>
</config>
