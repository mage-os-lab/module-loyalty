<?php
declare(strict_types=1);

/** @var \Magento\Checkout\Block\Cart\AbstractCart $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \MageOS\Loyalty\ViewModel\Account $viewModel */
$viewModel = $block->getData('view_model');
$used = (int) $block->getQuote()->getData('loyalty_points');
$balance = $block->getQuote()->getCustomerId() ? $viewModel->getBalance() : 0;
if ($balance <= 0 && !$used) {
    return;
}
?>
<details class="block loyalty-form group"<?= $used ? ' open' : '' ?>>
    <summary class="title list-none flex justify-between items-center gap-2 py-2 font-semibold">
        <strong class="font-semibold"><?= $escaper->escapeHtml(__('Use Loyalty Points')) ?></strong>
    </summary>
    <form class="mt-2 mb-4" action="<?= $escaper->escapeUrl($block->getUrl('loyalty/cart/apply')) ?>" method="post">
        <?= /* @noEscape */ $block->getBlockHtml('formkey') ?>
        <div class="fieldset space-y-2">
            <label for="loyalty_points" class="label">
                <?= $escaper->escapeHtml(
                    __('You have %1 points, worth %2.', $balance, $viewModel->getValue($balance))
                ) ?>
            </label>
            <input type="number" id="loyalty_points" name="loyalty_points" class="input-text form-input w-full"
                   min="1" max="<?= (int) $balance ?>" value="<?= $used ?: (int) $balance ?>"
                   <?= $used ? 'disabled' : 'required' ?>>
            <?php if ($used): ?>
                <input type="hidden" name="remove" value="1">
                <button type="submit" class="action primary btn btn-secondary w-full">
                    <?= $escaper->escapeHtml(__('Remove Loyalty Points')) ?>
                </button>
            <?php else: ?>
                <button type="submit" class="action primary btn btn-secondary w-full">
                    <?= $escaper->escapeHtml(__('Use Loyalty Points')) ?>
                </button>
            <?php endif; ?>
        </div>
    </form>
</details>
