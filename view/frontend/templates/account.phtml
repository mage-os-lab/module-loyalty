<?php
declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \MageOS\Loyalty\ViewModel\Account $viewModel */
$viewModel = $block->getData('view_model');
$balance = $viewModel->getBalance();
?>
<p class="text-xl font-semibold mb-4">
    <?= $escaper->escapeHtml(__('You have %1 points, worth %2.', $balance, $viewModel->getValue($balance))) ?>
</p>

<p class="mb-4">
    <?= $escaper->escapeHtml(__('Use your points in the cart to pay for all or part of an order.')) ?>
</p>

<table class="data table w-full">
    <caption class="sr-only"><?= $escaper->escapeHtml(__('Points history')) ?></caption>
    <thead>
        <tr>
            <th scope="col" class="text-left py-2"><?= $escaper->escapeHtml(__('Date')) ?></th>
            <th scope="col" class="text-left py-2"><?= $escaper->escapeHtml(__('Points')) ?></th>
            <th scope="col" class="text-left py-2"><?= $escaper->escapeHtml(__('Comment')) ?></th>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($viewModel->getHistory() as $entry): ?>
            <tr>
                <td class="py-2"><?= $escaper->escapeHtml($block->formatDate($entry['created_at'])) ?></td>
                <td class="py-2"><?= (int) $entry['points'] > 0 ? '+' : '' ?><?= (int) $entry['points'] ?></td>
                <td class="py-2"><?= $escaper->escapeHtml($viewModel->describe($entry)) ?></td>
            </tr>
        <?php endforeach; ?>
    </tbody>
</table>
