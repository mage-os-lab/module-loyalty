<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">mageos_loyalty_points_listing.mageos_loyalty_points_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>mageos_loyalty_points_columns</spinner>
        <deps>
            <dep>mageos_loyalty_points_listing.mageos_loyalty_points_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="mageos_loyalty_points_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entry_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>MageOS_Loyalty::points</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider"
                      name="mageos_loyalty_points_listing_data_source">
            <settings>
                <requestFieldName>entry_id</requestFieldName>
                <primaryFieldName>entry_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <exportButton name="export_button"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="mageos_loyalty_points_columns">
        <column name="entry_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="20">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Date</label>
            </settings>
        </column>
        <column name="customer_email" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer</label>
            </settings>
        </column>
        <column name="customer_id" sortOrder="35">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Customer ID</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="type" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <options class="MageOS\Loyalty\Model\Source\Type"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Type</label>
            </settings>
        </column>
        <column name="points" sortOrder="50">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Points</label>
            </settings>
        </column>
        <column name="order_number" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Order</label>
            </settings>
        </column>
        <column name="comment" sortOrder="70">
            <settings>
                <filter>text</filter>
                <label translate="true">Comment</label>
            </settings>
        </column>
        <column name="admin_user" sortOrder="80">
            <settings>
                <filter>text</filter>
                <label translate="true">Admin User</label>
            </settings>
        </column>
    </columns>
</listing>
